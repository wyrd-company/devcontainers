#!/usr/bin/env bash
#
# Pinned runtime management for the T3 Code service.
#
# A pinned runtime is one T3 Code version unpacked into
# <home>/.t3/runtime/versions/<version>/ with its executable at t3 and an
# .install-complete sentinel naming the version. The service runs the version
# recorded by the native service-state.json, or selected-version for a legacy
# runtime. The fixed service-launcher survives native child updates.

set -euo pipefail

config_file="${T3CODE_SERVER_CONFIG:-/usr/local/lib/t3code-server/config.env}"
# shellcheck disable=SC1090
source "${config_file}"

: "${T3CODE_SERVER_USER:?config.env must set T3CODE_SERVER_USER}"
: "${T3CODE_SERVER_HOME:?config.env must set T3CODE_SERVER_HOME}"

base_dir="${T3CODE_SERVER_HOME}/.t3"
runtime_dir="${base_dir}/runtime"
versions_dir="${runtime_dir}/versions"
state_tool="$(dirname "$(readlink -f "$0")")/service-state.py"
resolver="$(dirname "$(readlink -f "$0")")/resolve-executable.cjs"

log() {
    echo "[t3code-runtime] $*" >&2
}

err() {
    echo "[t3code-runtime] ERROR: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: t3code-runtime <command> [arguments]

  install-archive VERSION ARCHIVE_URL CHECKSUMS_URL
      Download a release archive, verify it against SHA256SUMS, and unpack it
      as the pinned runtime for VERSION.
  install-npm SPEC
      Install an npm package spec or tarball URL and expose its executable as a
      pinned runtime. Prints the installed version.
  select VERSION
      Select VERSION while the service is stopped (installer/maintenance only).
  prepare-archive VERSION ARCHIVE_URL CHECKSUMS_URL
      Verify and queue a separate runtime for the next stopped-service start.
  prepare-installed VERSION
      Queue a copy of a completely installed runtime without downloading it.
  bootstrap
      Apply queued local maintenance before starting the service launcher.
  selected-version
      Print the selected version.
  selected-entry
      Print the executable path of the selected version.
  versions
      Print every completely installed version, one per line.
  installed VERSION
      Exit 0 when VERSION is completely installed.
EOF
    exit 2
}

# Runs a command as the service user. The update command already runs this
# tool as that user; only the Feature installer runs it as root.
as_service_user() {
    if [ "$(id -u)" -eq 0 ]; then
        runuser --user "${T3CODE_SERVER_USER}" -- env HOME="${T3CODE_SERVER_HOME}" "$@"
    else
        "$@"
    fi
}

own_as_service_user() {
    if [ "$(id -u)" -eq 0 ]; then
        chown -R "${T3CODE_SERVER_USER}:$(id -gn "${T3CODE_SERVER_USER}")" "$@"
    fi
}

ensure_tree() {
    install -d -m 0755 "${base_dir}" "${runtime_dir}" "${versions_dir}"
    own_as_service_user "${base_dir}" "${runtime_dir}" "${versions_dir}"
}

version_dir() {
    printf '%s/%s' "${versions_dir}" "$1"
}

is_installed() {
    local dir
    dir="$(version_dir "$1")"
    [ -x "${dir}/t3" ] && [ -f "${dir}/.install-complete" ] \
        && [ "$(tr -d '[:space:]' <"${dir}/.install-complete")" = "$1" ]
}

require_version() {
    [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] \
        || err "'$1' is not an exact T3 Code version."
}

stage_dir=""
cleanup_stage() {
    if [ -n "${stage_dir}" ] && [ -d "${stage_dir}" ]; then
        rm -rf "${stage_dir}"
    fi
}

is_stage_path() {
    # A queued path must be one direct staging child, including through links.
    local candidate="$1" canonical parent
    [[ "${candidate##*/}" =~ ^\.staging-[[:alnum:]]+$ ]] || return 1
    [ ! -L "${candidate}" ] || return 1
    canonical="$(realpath -m -- "${candidate}")"
    parent="$(realpath -- "${versions_dir}")"
    [ "$(dirname -- "${canonical}")" = "${parent}" ]
}

queue_stage() {
    local version="$1" origin="$2" previous=""
    if [ -f "${runtime_dir}/queued-runtime" ]; then
        previous="$(sed -n '2p' "${runtime_dir}/queued-runtime")"
    fi
    printf '%s\n' "${version}" >"${stage_dir}/.maintenance-version"
    printf '%s\n%s\n%s\n' "${version}" "${stage_dir}" "${origin}" >"${runtime_dir}/.queued-runtime-next"
    mv "${runtime_dir}/.queued-runtime-next" "${runtime_dir}/queued-runtime"
    own_as_service_user "${stage_dir}" "${runtime_dir}/queued-runtime"
    if is_stage_path "${previous}" && [ -f "${previous}/.maintenance-version" ]; then
        rm -rf "${previous}"
    fi
    stage_dir=""
}

# Downloads, verifies, and unpacks an archive into a staging directory inside
# the versions tree, then renames it into place. The sentinel is written last,
# so a killed install never looks complete.
install_archive() {
    local version="$1" archive_url="$2" checksums_url="$3"
    local target archive_name expected actual origin=""
    local prepare="${4:-false}"
    require_version "${version}"
    ensure_tree
    if [ "${prepare}" = true ]; then
        origin="$(selected_version)"
    fi
    target="$(version_dir "${version}")"
    archive_name="${archive_url##*/}"

    stage_dir="$(mktemp -d "${versions_dir}/.staging-XXXXXX")"
    trap cleanup_stage EXIT

    log "Downloading ${archive_url}"
    curl --fail --silent --show-error --location --retry 3 \
        --output "${stage_dir}/SHA256SUMS" "${checksums_url}"
    curl --fail --silent --show-error --location --retry 3 \
        --output "${stage_dir}/${archive_name}" "${archive_url}"

    expected="$(awk -v name="${archive_name}" '$2 == name || $2 == "*" name { print $1 }' "${stage_dir}/SHA256SUMS")"
    [ -n "${expected}" ] || err "${archive_name} is not listed in ${checksums_url}."
    actual="$(sha256sum "${stage_dir}/${archive_name}" | cut -d' ' -f1)"
    [ "${actual}" = "${expected}" ] || err "Checksum mismatch for ${archive_name}."

    tar -xzf "${stage_dir}/${archive_name}" -C "${stage_dir}" --strip-components=1
    rm -f "${stage_dir}/${archive_name}" "${stage_dir}/SHA256SUMS"
    [ -x "${stage_dir}/t3" ] || err "The archive does not contain an executable t3."

    printf '%s\n' "${version}" >"${stage_dir}/.install-complete"
    if [ "${prepare}" = true ]; then
        # Native pruning ignores staging directories. Keep maintenance separate
        # from published runtimes until the launcher and its child have stopped.
        queue_stage "${version}" "${origin}"
        return
    fi
    rm -rf "${target}"
    mv "${stage_dir}" "${target}"
    stage_dir=""
    own_as_service_user "${target}"
    log "Installed T3 Code ${version} at ${target}"
}

# Installs an npm package into a prefix inside its own runtime directory and
# exposes it through a shim laid out like an archive runtime, so both kinds are
# run the same way and each npm version stays pinned. The version is whatever
# the package reports.
#
# The shim execs the platform binary when the package ships one, because the
# package's own `t3` bin is a Node shim that does not forward signals: under s6
# a restart would kill that shim and orphan the server with the port bound.
install_npm() {
    local spec="$1" version target executable
    command -v npm >/dev/null 2>&1 || err "npm is required to install ${spec}."
    ensure_tree

    stage_dir="$(mktemp -d "${versions_dir}/.staging-XXXXXX")"
    chmod 0755 "${stage_dir}"
    trap cleanup_stage EXIT

    log "Installing ${spec} with npm"
    env NPM_CONFIG_ENGINE_STRICT=true NPM_CONFIG_UPDATE_NOTIFIER=false \
        npm install --global --prefix "${stage_dir}/npm" "${spec}" >&2
    [ -x "${stage_dir}/npm/bin/t3" ] || err "npm did not install a t3 executable."

    version="$(as_service_user "${stage_dir}/npm/bin/t3" --version)"
    version="${version#t3 v}"
    require_version "${version}"

    # Everything is written inside the staging directory before it moves into
    # place, so a killed install never looks complete.
    target="$(version_dir "${version}")"
    executable="$(node "${resolver}" "${stage_dir}/npm/lib/node_modules/t3" "${stage_dir}/npm/bin/t3")"
    [ -x "${executable}" ] || err "T3 Code executable is not runnable: ${executable}."
    executable="${target}${executable#"${stage_dir}"}"
    cat >"${stage_dir}/t3" <<EOF
#!/usr/bin/env bash
exec ${executable@Q} "\$@"
EOF
    chmod 0755 "${stage_dir}/t3"
    printf '%s\n' "${version}" >"${stage_dir}/.install-complete"

    rm -rf "${target}"
    mv "${stage_dir}" "${target}"
    stage_dir=""
    own_as_service_user "${target}"
    log "Installed T3 Code ${version} at ${target}; the service execs ${executable}"
    printf '%s\n' "${version}"
}

# Detect the external launcher protocol, rather than selecting by version.
# Older releases keep their direct-server path and exact pins remain usable.
select_version() {
    local version="$1" preflight preflight_errors protocol="legacy" preflight_status=0
    require_version "${version}"
    is_installed "${version}" || err "T3 Code ${version} is not completely installed."
    ensure_tree
    preflight_errors="$(mktemp)"
    preflight="$(as_service_user "$(version_dir "${version}")/t3" __service-preflight \
        --database-path "${base_dir}/userdata/statev2.sqlite" --launcher-protocol 3 2>"${preflight_errors}")" || preflight_status=$?
    if [ "${preflight_status}" -eq 0 ] && python3 -c 'import json,sys; p=json.load(sys.stdin); sys.exit(not (p.get("status")=="ready" and p.get("launcherProtocol")==3 and p.get("version")==sys.argv[1]))' \
        "${version}" <<<"${preflight}" 2>/dev/null; then
        protocol=3
    else
        log "Native launcher preflight did not pass for ${version} (exit ${preflight_status}); using direct startup: ${preflight:-no output}"
    fi
    if [ -s "${preflight_errors}" ]; then
        log "Preflight diagnostics: $(cat "${preflight_errors}")"
    fi
    rm -f "${preflight_errors}"
    as_service_user python3 "${state_tool}" "${runtime_dir}" select "${version}" "${protocol}"
    log "Selected T3 Code ${version} (${protocol}) for the service"
}

selected_version() {
    python3 "${state_tool}" "${runtime_dir}" selected
}

bootstrap() {
    ensure_tree
    # Local preparation and startup share a lock; native state is only written
    # here before the launcher starts. Pending native updates recover first.
    exec 9>"${runtime_dir}/maintenance.lock"
    flock 9
    selected_version >/dev/null
    if [ -f "${runtime_dir}/queued-runtime" ] && ! python3 "${state_tool}" "${runtime_dir}" pending; then
        local stage version target origin current
        local -a queued
        mapfile -t queued <"${runtime_dir}/queued-runtime"
        [ "${#queued[@]}" -eq 3 ] || err "Invalid queued runtime."
        version="${queued[0]}"
        stage="${queued[1]}"
        origin="${queued[2]}"
        is_stage_path "${stage}" || err "Invalid queued runtime path."
        require_version "${version}"
        require_version "${origin}"
        current="$(selected_version)"
        if [ "${current}" != "${origin}" ]; then
            log "Discarding queued ${version}: active version changed from ${origin} to ${current}."
            rm -rf "${stage}"
            rm -f "${runtime_dir}/queued-runtime"
            return
        fi
        target="$(version_dir "${version}")"
        if [ -d "${stage}" ]; then
            [ "$(cat "${stage}/.maintenance-version")" = "${version}" ] || err "Queued version mismatch."
            rm -rf "${target}"
            mv "${stage}" "${target}"
        fi
        select_version "${version}"
        rm -f "${runtime_dir}/queued-runtime"
    fi
    flock -u 9
    exec 9>&-
}

list_versions() {
    local dir version
    [ -d "${versions_dir}" ] || return 0
    for dir in "${versions_dir}"/*/; do
        [ -d "${dir}" ] || continue
        version="$(basename "${dir}")"
        if is_installed "${version}"; then
            printf '%s\n' "${version}"
        fi
    done
}

[ $# -ge 1 ] || usage
command="$1"
shift
case "${command}" in
    install-archive)
        [ $# -eq 3 ] || usage
        install_archive "$1" "$2" "$3"
        ;;
    install-npm)
        [ $# -eq 1 ] || usage
        install_npm "$1"
        ;;
    prepare-archive)
        [ $# -eq 3 ] || usage
        ensure_tree
        exec 9>"${runtime_dir}/maintenance.lock"
        flock 9
        install_archive "$1" "$2" "$3" true
        ;;
    prepare-installed)
        [ $# -eq 1 ] || usage
        require_version "$1"
        ensure_tree
        exec 9>"${runtime_dir}/maintenance.lock"
        flock 9
        is_installed "$1" || err "T3 Code $1 is not completely installed."
        origin="$(selected_version)"
        stage_dir="$(mktemp -d "${versions_dir}/.staging-XXXXXX")"
        trap cleanup_stage EXIT
        cp -a "$(version_dir "$1")/." "${stage_dir}/"
        queue_stage "$1" "${origin}"
        ;;
    pending-update)
        python3 "${state_tool}" "${runtime_dir}" pending
        ;;
    bootstrap)
        [ $# -eq 0 ] || usage
        bootstrap
        ;;
    select)
        [ $# -eq 1 ] || usage
        select_version "$1"
        ;;
    selected-version)
        selected_version
        ;;
    selected-entry)
        selected="$(selected_version)"
        printf '%s/t3\n' "$(version_dir "${selected}")"
        ;;
    versions)
        list_versions
        ;;
    installed)
        [ $# -eq 1 ] || usage
        is_installed "$1"
        ;;
    *)
        usage
        ;;
esac
