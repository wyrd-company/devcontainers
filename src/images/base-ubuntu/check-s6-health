#!/bin/sh
set -eu

fail() {
    printf '%s\n' "$*" >&2
    exit 1
}

check_longrun() {
    service_dir=$1
    service=${service_dir##*/}
    status=$(/command/s6-svstat -o up,ready "$service_dir") ||
        fail "s6 supervisor status is unavailable: $service"
    case "$status" in
        'true true') ;;
        'true false')
            [ ! -f "$service_dir/notification-fd" ] || fail "s6 service is not ready: $service"
            ;;
        *) fail "s6 service is not running: $service" ;;
    esac

    # s6-svdt returns the most recent deaths in chronological order.
    deaths=$(/command/s6-svdt -n 2 "$service_dir") ||
        fail "s6 restart history is unavailable: $service"
    case "$deaths" in
        *'
'*)
            oldest_exit=$(printf '%s\n' "${deaths%% *}" | TZ=UTC /command/s6-tai64nlocal)
            oldest_exit_epoch=$(date -u -d "$oldest_exit" +%s) ||
                fail "s6 restart history has an invalid timestamp: $service"
            now=$(date -u +%s)
            [ "$oldest_exit_epoch" -le "$((now - 60))" ] ||
                fail "s6 service exited repeatedly: $service"
            ;;
    esac

    if [ -x "$service_dir/data/healthcheck" ]; then
        "$service_dir/data/healthcheck" || fail "s6 service health probe failed: $service"
    fi
}

live=$(readlink -e /run/s6-rc) ||
    fail 's6-rc has not initialized its service database'
required=$(/command/s6-rc-db -c "$live/compiled" all-dependencies top) ||
    fail 's6-rc has not initialized its service database'
# s6-rc replaces its state file atomically. A read-only probe can read it
# without a lock, leaving startup and operator-driven changes free to run.
active=$(/command/s6-rc --no-lock -l "$live" -a list) ||
    fail 's6-rc service state is unavailable'
longruns=$(/command/s6-rc-db -c "$live/compiled" list longruns) ||
    fail 's6-rc could not list its longruns'

while IFS= read -r name; do
    if ! printf '%s\n' "$active" | grep -Fxq -- "$name"; then
        fail "s6-rc service has not started: $name"
    fi
    # A longrun can stop while still marked active by s6-rc.
    if printf '%s\n' "$longruns" | grep -Fxq -- "$name"; then
        check_longrun "/run/service/$name"
    fi
done <<EOF
$required
EOF

# s6-overlay copies legacy services here before adding them to supervision.
for legacy_dir in /run/s6/legacy-services/*; do
    [ -d "$legacy_dir" ] || continue
    [ ! -e "$legacy_dir/down" ] || continue
    check_longrun "$legacy_dir"
done
