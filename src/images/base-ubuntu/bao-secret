#!/usr/bin/env bash
#
# bao-secret: read a field of an OpenBao KV version 2 secret, with curl and jq.
#
#   bao-secret get <mount>/<path>/<field>   print the field's value
#   bao-secret vector                       answer a Vector exec secret backend request
#
# The address comes from BAO_ADDR, then VAULT_ADDR: unix:///path/to.sock, or
# http(s)://host:port. The address must authenticate the caller itself, as the
# Wyrwood socket or an OpenBao Agent API proxy with auto-auth do: bao-secret
# never reads, sends or stores a token.
#
# Values never touch the disk, the environment or a command line. Errors never
# include a value.

set -euo pipefail

usage() {
    echo "usage: bao-secret get <mount>/<path>/<field>" >&2
    echo "       bao-secret vector" >&2
    exit 2
}

address="${BAO_ADDR:-${VAULT_ADDR:-}}"

# A reference is <mount>/<path>/<field>: at least three segments of letters,
# digits, '.', '_' and '-'. The last segment is the field and the first is the
# mount. '.' and '..' are rejected so that a reference cannot reach another API.
reference_error() {
    local reference="$1" segment
    local -a segments
    IFS=/ read -r -a segments <<<"${reference}"
    if [ "${#segments[@]}" -lt 3 ] || [[ "${reference}" == */ ]]; then
        echo "reference must be <mount>/<path>/<field>"
        return
    fi
    for segment in "${segments[@]}"; do
        if ! [[ "${segment}" =~ ^[A-Za-z0-9._-]+$ ]] || [ "${segment}" = . ] || [ "${segment}" = .. ]; then
            echo "reference segments may hold only letters, digits, '.', '_' and '-', and may not be '.' or '..'"
            return
        fi
    done
}

# Prints the response body followed by a line with the HTTP status.
request() {
    local path="$1"
    local -a target
    case "${address}" in
        unix://*) target=(--unix-socket "${address#unix://}" "http://localhost${path}") ;;
        http://* | https://*) target=("${address%/}${path}") ;;
        '') return 3 ;;
        *) return 4 ;;
    esac
    curl --silent --show-error --max-time 10 --write-out '\n%{http_code}' "${target[@]}" 2>/dev/null
}

# Reads the secret at <mount>/<path> into the global `body`, or sets the global
# `failure` to a message without the secret.
body=''
failure=''
read_secret() {
    local secret="$1" mount path response status rc=0
    mount="${secret%%/*}"
    path="${secret#*/}"
    body=''
    failure=''
    response="$(request "/v1/${mount}/data/${path}")" || rc=$?
    case "${rc}" in
        0) ;;
        3) failure="BAO_ADDR and VAULT_ADDR are not set"; return ;;
        4) failure="the address must start with unix://, http:// or https://"; return ;;
        *) failure="could not reach OpenBao at ${address}"; return ;;
    esac
    status="${response##*$'\n'}"
    body="${response%$'\n'*}"
    case "${status}" in
        200) ;;
        404) failure="secret ${secret} was not found" ;;
        403) failure="permission denied for secret ${secret}" ;;
        *) failure="OpenBao returned HTTP ${status} for secret ${secret}" ;;
    esac
    if [ -n "${failure}" ]; then
        body=''
    fi
}

# The jq program that turns a KV version 2 response and a field name into
# {"value": ..., "error": ...}. Strings, numbers and booleans are values.
field_program='
    (.data.data // {}) as $data
    | if ($data | has($field)) | not then
        {value: null, error: ("field " + $field + " was not found in secret " + $secret)}
      elif ($data[$field] | type) == "string" then
        {value: $data[$field], error: null}
      elif ($data[$field] | type) == "number" or ($data[$field] | type) == "boolean" then
        {value: ($data[$field] | tostring), error: null}
      else
        {value: null, error: ("field " + $field + " of secret " + $secret + " is not a string, number or boolean")}
      end
'

cmd_get() {
    [ "$#" -eq 1 ] || usage
    local reference="$1" problem secret field result error
    problem="$(reference_error "${reference}")"
    if [ -n "${problem}" ]; then
        echo "bao-secret: ${problem}" >&2
        exit 2
    fi
    secret="${reference%/*}"
    field="${reference##*/}"
    read_secret "${secret}"
    if [ -n "${failure}" ]; then
        echo "bao-secret: ${failure}" >&2
        exit 1
    fi
    # printf is a builtin, so the body reaches jq on stdin and not on a command line.
    result="$(printf '%s' "${body}" | jq --compact-output --arg field "${field}" --arg secret "${secret}" "${field_program}" 2>/dev/null)" || {
        echo "bao-secret: OpenBao returned a response that is not a KV version 2 secret" >&2
        exit 1
    }
    error="$(printf '%s' "${result}" | jq --raw-output '.error // empty')"
    if [ -n "${error}" ]; then
        echo "bao-secret: ${error}" >&2
        exit 1
    fi
    printf '%s' "${result}" | jq --raw-output '.value'
}

# Vector sends {"version":"1.0","secrets":["<reference>", ...]} on stdin and
# expects {"<reference>":{"value":"...","error":null}, ...} on stdout.
cmd_vector() {
    [ "$#" -eq 0 ] || usage
    local request_json reference problem secret field
    local -A bodies=() failures=()
    local -a answers=()
    local -a references=()
    request_json="$(cat)"
    if ! printf '%s' "${request_json}" | jq --exit-status '.secrets | type == "array"' >/dev/null 2>&1; then
        echo "bao-secret: the request from Vector has no secrets array" >&2
        exit 1
    fi
    mapfile -t references < <(printf '%s' "${request_json}" | jq --raw-output '.secrets[]')
    for reference in "${references[@]}"; do
        problem="$(reference_error "${reference}")"
        if [ -n "${problem}" ]; then
            answers+=("$(jq --null-input --compact-output --arg key "${reference}" --arg error "${problem}" \
                '{($key): {value: null, error: $error}}')")
            continue
        fi
        secret="${reference%/*}"
        field="${reference##*/}"
        # Each secret is read once, however many of its fields are requested.
        if [ -z "${bodies["${secret}"]+x}" ] && [ -z "${failures["${secret}"]+x}" ]; then
            read_secret "${secret}"
            if [ -n "${failure}" ]; then
                failures["${secret}"]="${failure}"
            else
                bodies["${secret}"]="${body}"
            fi
        fi
        if [ -n "${failures["${secret}"]+x}" ]; then
            answers+=("$(jq --null-input --compact-output --arg key "${reference}" --arg error "${failures["${secret}"]}" \
                '{($key): {value: null, error: $error}}')")
            continue
        fi
        answers+=("$(printf '%s' "${bodies["${secret}"]}" \
            | jq --compact-output --arg key "${reference}" --arg field "${field}" --arg secret "${secret}" \
                "{(\$key): (${field_program})}" 2>/dev/null \
            || jq --null-input --compact-output --arg key "${reference}" \
                '{($key): {value: null, error: "OpenBao returned a response that is not a KV version 2 secret"}}')")
    done
    if [ "${#answers[@]}" -eq 0 ]; then
        echo '{}'
    else
        printf '%s\n' "${answers[@]}" | jq --compact-output --slurp 'add'
    fi
}

[ "$#" -ge 1 ] || usage
command="$1"
shift
case "${command}" in
    get) cmd_get "$@" ;;
    vector) cmd_vector "$@" ;;
    -h | --help | help) usage ;;
    *) usage ;;
esac
