#!/bin/bash -p
#
# bao-secret: read a field of an OpenBao KV version 2 secret, with curl and jq.
#
#   bao-secret get <mount>/<path>/<field>   print the field's value
#   bao-secret vector                       answer a Vector exec secret backend request
#
# The address comes from BAO_ADDR, then VAULT_ADDR: unix:///path/to.sock, or
# http(s)://host[:port]. The address must authenticate the caller itself, as
# the Wyrwood socket or an OpenBao Agent API proxy with auto-auth do:
# bao-secret never reads, sends or stores a token.
#
# Values never touch the disk, the environment or a command line, and errors
# never include a value or the address.
#
# Run it directly, not as `bash bao-secret`: the -p in the interpreter line
# makes bash ignore exported functions, SHELLOPTS, BASHOPTS and BASH_ENV
# before the first line runs, so an inherited function cannot replace `set`,
# `unset` or anything else used here, and inherited options cannot turn on
# tracing. -p changes nothing else when the real and effective IDs match.

# Belt and braces for the cases -p does not cover: an inherited export
# attribute would hand a value to every child, and options set by a caller
# that ran this file through `bash` would trace it.
set +o xtrace +o verbose +o allexport
# shellcheck disable=SC2046
unset -f $(compgen -A function) 2>/dev/null || true
unset address body failure result error reference secret field status response request_json \
    references answers bodies failures valid_program field_program command 2>/dev/null || true
set -euo pipefail

usage() {
    echo "usage: bao-secret get <mount>/<path>/<field>" >&2
    echo "       bao-secret vector" >&2
    exit 2
}

# A reference is <mount>/<path>/<field>: at least three segments of letters,
# digits, '.', '_' and '-', with nothing else, not even a trailing newline.
# '.' and '..' are refused so that a reference cannot reach another API. The
# last segment is the field and the first is the mount.
valid_program='
    def reference_error:
        if type != "string" then "reference must be a string"
        elif test("\\A[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+){2,}\\z") | not then
            "reference must be <mount>/<path>/<field>, in segments of letters, digits, \u0027.\u0027, \u0027_\u0027 and \u0027-\u0027"
        elif split("/") | any(. == "." or . == "..") then
            "reference segments may not be \u0027.\u0027 or \u0027..\u0027"
        else empty
        end;
'

# The jq program that turns the slurped OpenBao response and a field name into
# {"value": ..., "error": ...}. Exactly one KV version 2 object is accepted.
# Strings, numbers and booleans are values.
field_program='
    if length != 1 or (.[0] | type) != "object" or (.[0].data | type) != "object"
        or (.[0].data.data | type) != "object" then
        {value: null, error: ("OpenBao did not return a KV version 2 secret for " + $secret)}
    else
        .[0].data.data as $data
        | if ($data | has($field)) | not then
            {value: null, error: ("field " + $field + " was not found in secret " + $secret)}
          elif ($data[$field] | type) == "string" then
            {value: $data[$field], error: null}
          elif ($data[$field] | type) == "number" or ($data[$field] | type) == "boolean" then
            {value: ($data[$field] | tostring), error: null}
          else
            {value: null, error: ("field " + $field + " of secret " + $secret + " is not a string, number or boolean")}
          end
    end
'

address="${BAO_ADDR:-${VAULT_ADDR:-}}"

# Checks the address before curl sees it, so that curl's own exit statuses
# are never mistaken for address errors. Messages do not repeat the address,
# which could hold credentials.
address_error() {
    case "${address}" in
        '') echo "BAO_ADDR and VAULT_ADDR are not set" ;;
        unix://*)
            [[ "${address#unix://}" =~ ^/[^[:space:]]+$ ]] || echo "a unix:// address must name an absolute socket path" ;;
        http://* | https://*)
            [[ "${address}" =~ ^https?://([A-Za-z0-9.-]+|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?/?$ ]] \
                || echo "an http(s):// address must be scheme://host[:port]" ;;
        *) echo "the address must start with unix://, http:// or https://" ;;
    esac
}

# Prints the response body followed by a line with the HTTP status. --disable
# keeps a user's .curlrc from writing the response elsewhere or adding headers.
request() {
    local path="$1"
    local -a target
    case "${address}" in
        unix://*) target=(--unix-socket "${address#unix://}" "http://localhost${path}") ;;
        *) target=("${address%/}${path}") ;;
    esac
    curl --disable --silent --max-time 10 --write-out '\n%{http_code}' "${target[@]}" 2>/dev/null
}

# Reads the secret at <mount>/<path> into the global `body`, or sets the global
# `failure` to a message without the secret.
body=''
failure=''
read_secret() {
    local secret="$1" mount path response status problem rc=0
    body=''
    failure=''
    problem="$(address_error)"
    if [ -n "${problem}" ]; then
        failure="${problem}"
        return
    fi
    mount="${secret%%/*}"
    path="${secret#*/}"
    response="$(request "/v1/${mount}/data/${path}")" || rc=$?
    if [ "${rc}" -ne 0 ]; then
        failure="could not reach OpenBao (curl exit status ${rc})"
        return
    fi
    status="${response##*$'\n'}"
    if [ "${status}" = "${response}" ]; then
        body=''
    else
        body="${response%$'\n'*}"
    fi
    case "${status}" in
        200) ;;
        404) failure="secret ${secret} was not found" ;;
        403) failure="permission denied for secret ${secret}" ;;
        *) failure="OpenBao returned HTTP ${status} for secret ${secret}" ;;
    esac
    if [ -n "${failure}" ]; then
        body=''
    fi
}

# Prints {"value": ..., "error": ...} for one field of the body just read. The
# body reaches jq on stdin through the printf builtin, never on a command line.
extract() {
    local secret="$1" field="$2"
    printf '%s' "${body}" \
        | jq --compact-output --slurp --arg field "${field}" --arg secret "${secret}" "${field_program}" 2>/dev/null \
        || jq --null-input --compact-output --arg secret "${secret}" \
            '{value: null, error: ("OpenBao did not return a KV version 2 secret for " + $secret)}'
}

cmd_get() {
    [ "$#" -eq 1 ] || usage
    local reference="$1" problem secret field result error
    problem="$(jq --null-input --raw-output --arg reference "${reference}" "${valid_program}"' $reference | reference_error')"
    if [ -n "${problem}" ]; then
        echo "bao-secret: ${problem}" >&2
        exit 2
    fi
    secret="${reference%/*}"
    field="${reference##*/}"
    read_secret "${secret}"
    if [ -n "${failure}" ]; then
        echo "bao-secret: ${failure}" >&2
        exit 1
    fi
    result="$(extract "${secret}" "${field}")"
    body=''
    error="$(printf '%s' "${result}" | jq --raw-output '.error // empty')"
    if [ -n "${error}" ]; then
        echo "bao-secret: ${error}" >&2
        exit 1
    fi
    printf '%s' "${result}" | jq --raw-output '.value'
}

# Vector sends {"version":"1.0","secrets":["<reference>", ...]} on stdin and
# expects {"<reference>":{"value":"...","error":null}, ...} on stdout. Every
# requested key gets an answer under exactly the key Vector sent.
cmd_vector() {
    [ "$#" -eq 0 ] || usage
    local request_json reference secret field
    local -A bodies=() failures=()
    local -a answers=() references=()
    request_json="$(cat)"
    if ! printf '%s' "${request_json}" | jq --exit-status '.secrets | type == "array"' >/dev/null 2>&1; then
        echo "bao-secret: the request from Vector has no secrets array" >&2
        exit 1
    fi
    # jq answers invalid keys itself, so the shell never splits or trims a
    # key. Valid keys hold no whitespace, so they pass one per line.
    answers+=("$(printf '%s' "${request_json}" | jq --compact-output "${valid_program}"'
        [.secrets[] | . as $key | reference_error as $error
            | {key: ($key | if type == "string" then . else tojson end), value: {value: null, error: $error}}]
        | from_entries')")
    mapfile -t references < <(printf '%s' "${request_json}" \
        | jq --raw-output "${valid_program}"' .secrets[] | select([reference_error] | length == 0)')
    for reference in "${references[@]}"; do
        secret="${reference%/*}"
        field="${reference##*/}"
        # Each secret is read once, however many of its fields are requested.
        if [ -z "${bodies["${secret}"]+x}" ] && [ -z "${failures["${secret}"]+x}" ]; then
            read_secret "${secret}"
            if [ -n "${failure}" ]; then
                failures["${secret}"]="${failure}"
            else
                bodies["${secret}"]="${body}"
            fi
        fi
        if [ -n "${failures["${secret}"]+x}" ]; then
            answers+=("$(jq --null-input --compact-output --arg key "${reference}" --arg error "${failures["${secret}"]}" \
                '{($key): {value: null, error: $error}}')")
            continue
        fi
        body="${bodies["${secret}"]}"
        answers+=("$(extract "${secret}" "${field}" | jq --compact-output --arg key "${reference}" '{($key): .}')")
    done
    body=''
    printf '%s\n' "${answers[@]}" | jq --compact-output --slurp 'add // {}'
}

[ "$#" -ge 1 ] || usage
command="$1"
shift
case "${command}" in
    get) cmd_get "$@" ;;
    vector) cmd_vector "$@" ;;
    *) usage ;;
esac
