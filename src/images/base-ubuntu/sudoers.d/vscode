# Restrict the vscode user to package installation and s6-overlay service control.
# Replaces the unrestricted "vscode ALL=(root) NOPASSWD:ALL" rule from the upstream image.
#
# The apt rules are anchored regular expressions so that the first non-option word
# must be the operation. Options that take a value must be written as "-o value",
# "-ovalue", or "--name=value". Package words must not end in "-" or "_", which apt
# treats as remove and purge.

Cmnd_Alias APT_UPDATE = /usr/bin/apt-get ^((-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup)) )*update( (-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup)))*$, \
                        /usr/bin/apt ^((-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup)) )*update( (-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup)))*$
Cmnd_Alias APT_INSTALL = /usr/bin/apt-get ^((-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup)) )*install( ((-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup))|([^ -][^ ]*[^ _-]|[^ _-])))+$, \
                         /usr/bin/apt ^((-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup)) )*install( ((-[yqsdfmubV]+|-[otca] ?[^ ]+|--[a-z-]+\=[^ ]+|--(yes|assume-yes|quiet|simulate|dry-run|just-print|no-act|recon|download-only|fix-broken|fix-missing|ignore-missing|no-download|no-install-recommends|install-recommends|no-install-suggests|install-suggests|reinstall|no-upgrade|only-upgrade|allow-downgrades|show-progress|print-uris|verbose-versions|no-list-cleanup))|([^ -][^ ]*[^ _-]|[^ _-])))+$
Cmnd_Alias S6_SERVICES = /command/s6-svc * /run/service/*, \
                         /command/s6-svstat * /run/service/*, /command/s6-svstat /run/service/*, \
                         /command/s6-rc *

Defaults:vscode env_keep += "DEBIAN_FRONTEND"

vscode ALL=(root) NOPASSWD: APT_UPDATE, APT_INSTALL, S6_SERVICES
