#!/usr/bin/env bash
#
# Update the T3 Code service inside the container.
#
# Resolves an upstream release, installs it as a pinned runtime beside the
# running one, selects it, and restarts the s6 service so it starts the new
# version.
#
# Run through sudo, root controls the s6 service only. Resolving,
# installing, and selecting run as the service user, in the runtime tree that
# user owns, so root never writes where that user can redirect the write.

set -euo pipefail

lib_dir=/usr/local/lib/t3code-server
config_file="${T3CODE_SERVER_CONFIG:-${lib_dir}/config.env}"
# shellcheck disable=SC1090
source "${config_file}"
runtime="${lib_dir}/t3code-runtime"
service_dir=/run/service/t3code-server

usage() {
    cat >&2 <<'EOF'
usage: t3code-server-update [--force] [--no-restart] [VERSION|latest]
       t3code-server-update --status

Installs upstream T3 Code VERSION (default: latest) and switches the service
to it.

  --force       Reinstall VERSION even when it is already installed.
  --no-restart  Queue the version without restarting the service; it takes
                effect on the next service start.
  --status      Show the selected and installed versions, then exit.
EOF
    exit 2
}

log() {
    echo "[t3code-server-update] $*"
}

err() {
    echo "[t3code-server-update] ERROR: $*" >&2
    exit 1
}

as_service_user() {
    if [ "$(id -u)" -ne 0 ] || [ "${T3CODE_SERVER_USER}" = root ]; then
        "$@"
    else
        runuser --user "${T3CODE_SERVER_USER}" -- \
            env HOME="${T3CODE_SERVER_HOME}" USER="${T3CODE_SERVER_USER}" LOGNAME="${T3CODE_SERVER_USER}" "$@"
    fi
}

force=false
restart=true
status=false
requested=""
while [ $# -gt 0 ]; do
    case "$1" in
        --force) force=true ;;
        --no-restart) restart=false ;;
        --status) status=true ;;
        -h|--help) usage ;;
        -*) usage ;;
        *)
            [ -z "${requested}" ] || usage
            requested="$1"
            ;;
    esac
    shift
done

if [ "${status}" = true ]; then
    [ -z "${requested}" ] || usage
    selected="$(as_service_user "${runtime}" selected-version)"
    printf 'selected version: %s\n' "${selected}"
    if [ -f "${T3CODE_SERVER_HOME}/.t3/runtime/queued-runtime" ]; then
        queued="$(as_service_user head -n 1 "${T3CODE_SERVER_HOME}/.t3/runtime/queued-runtime")"
        printf 'queued version: %s\n' "${queued}"
    fi
    printf 'installed versions:\n'
    as_service_user "${runtime}" versions | sed 's/^/  /'
    if [ -d "${service_dir}" ]; then
        printf 'service: %s\n' "$(/command/s6-svstat "${service_dir}" 2>/dev/null || echo unknown)"
    else
        printf 'service: not supervised\n'
    fi
    exit 0
fi

requested="${requested:-latest}"

# Updates install release archives only, so the version must be `latest` or
# exact. Anything else would resolve to an npm install, and through sudo an npm
# spec can name arbitrary code.
if [[ "${requested}" =~ ^[vV]([0-9].*)$ ]]; then
    requested="${BASH_REMATCH[1]}"
fi
[ "${requested}" = latest ] \
    || [[ "${requested}" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] \
    || err "'${requested}' is not latest or an exact version."

[ "$(id -u)" -eq 0 ] || err "Run this command as root, for example with sudo."


mapfile -t resolution < <(
    as_service_user python3 "${lib_dir}/resolve-package-source.py" \
        "${requested}" "${T3CODE_SERVER_ARCH}"
)
[ "${#resolution[@]}" -eq 4 ] || err "Unable to resolve T3 Code ${requested}."
kind="${resolution[0]}"
source="${resolution[1]}"
version="${resolution[2]}"
checksums="${resolution[3]}"

# Serialize local updaters without giving root any write in the user's tree.
exec 9>/run/t3code-server-update.lock
flock 9
[ "${kind}" = archive ] || err "Unknown package kind '${kind}'."
current="$(as_service_user "${runtime}" selected-version)"
if [ "${current}" = "${version}" ] && [ "${force}" != true ] \
    && [ ! -f "${T3CODE_SERVER_HOME}/.t3/runtime/queued-runtime" ]; then
    log "T3 Code ${version} is already the selected version."
    exit 0
fi

# Prepare away from native runtimes: neither --force nor a concurrent remote
# update can overwrite a running executable. Startup applies the queue only
# while the launcher is stopped, so there is one native state writer at a time.
if [ "${force}" != true ] && as_service_user "${runtime}" installed "${version}"; then
    log "Reusing the installed T3 Code ${version} runtime."
    as_service_user "${runtime}" prepare-installed "${version}"
else
    as_service_user "${runtime}" prepare-archive "${version}" "${source}" "${checksums}"
fi
if [ "${restart}" != true ]; then
    log "T3 Code ${version} is queued for the next service start."
    exit 0
fi
if [ ! -d "${service_dir}" ]; then
    log "The service is not supervised; T3 Code ${version} is queued for its next start."
    exit 0
fi

# Wait for the launcher to finish terminating its child before changing state.
# s6's default wait has no deadline; the upstream launcher owns graceful stop.
wanted_up="$(/command/s6-svstat -o wantedup "${service_dir}")"
/command/s6-svc -wD -d "${service_dir}"
pending=false
if as_service_user "${runtime}" pending-update; then
    pending=true
fi
if [ "${wanted_up}" = true ]; then
    /command/s6-svc -u "${service_dir}"
    log "Restarted the T3 Code service."
else
    as_service_user "${runtime}" bootstrap
    log "Updated the stopped service; it remains stopped."
fi
if [ "${pending}" = true ]; then
    log "Native recovery takes priority. After recovery, restart once more to apply the queue if its originating version is still active."
fi
