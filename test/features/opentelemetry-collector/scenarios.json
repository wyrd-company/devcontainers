{
  "opentelemetry-collector-contrib": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "opentelemetry-collector": {
        "version": "0.160.0",
        "distribution": "contrib",
        "serviceUser": "root"
      }
    }
  },
  "opentelemetry-collector-openbao-agent": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "opentelemetry-collector": {},
      "openbao-agent": {}
    },
    "overrideFeatureInstallOrder": [
      "./openbao-agent",
      "./opentelemetry-collector"
    ]
  }
}
