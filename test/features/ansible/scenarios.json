{
  "ansible-configured": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "ansible": {
        "source": "ssh://git@example.test:2222/sample-team/sample-playbooks.git",
        "playbook": "container/site.yml",
        "ref": "release-1",
        "inventory": "inventory/local.ini",
        "requirements": "requirements.yml",
        "args": "--tags base -e sample_flag=true",
        "checkoutDir": "/opt/sample-checkout",
        "serviceUser": "automatic",
        "sudoUser": "automatic"
      }
    },
    "remoteUser": "vscode"
  },
  "ansible-ssh-url-without-user": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "ansible": {
        "source": "ssh://example.test:2222/sample-playbooks.git"
      }
    }
  },
  "ansible-local-source": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "ansible": {
        "source": "/srv/sample-playbooks"
      }
    }
  }
}
