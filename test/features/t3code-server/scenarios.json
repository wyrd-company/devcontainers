{
  "t3code-server-custom-options": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "port": "4123",
        "host": "127.0.0.1",
        "serviceUser": "root",
        "releaseBaseUrl": "https://releases.example.test/t3"
      }
    }
  },
  "t3code-server-caddy": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "port": "4123",
        "dnsName": "t3.test-container.example.test"
      },
      "caddy": {}
    }
  },
  "t3code-server-upstream-archive": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "version": "0.0.42"
      }
    }
  },
  "t3code-server-fork-package-source": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "packageSource": "github:wyrd-company/t3code",
        "version": "0.0.42-wyrd.2"
      }
    }
  },
  "t3code-server-fork-latest": {
    "image": "ghcr.io/wyrd-company/devcontainers/base:noble",
    "features": {
      "t3code-server": {
        "packageSource": "github:wyrd-company/t3code",
        "version": "latest",
        "serveMode": "web"
      }
    }
  }
}
